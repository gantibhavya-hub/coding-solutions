#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)
	{
	    int n;
	    cin>>n;
	    long long a[n];
	    long long sum=0;
	    long long maxi=0;
	    for(int i=0;i<n;i++)
	    {
	        cin>>a[i];
	        sum+=a[i];
	        maxi=max(maxi,a[i]);
	    }
	    long long ans=sum-maxi;
	    for(int i=0;i<n;i++)
	    {
	        long long newSum=sum+a[i];
	        long long newMax=max(maxi,2*a[i]);
	        ans=max(ans,newSum-newMax);
	    }
	    cout<<ans<<endl;
	}

}
