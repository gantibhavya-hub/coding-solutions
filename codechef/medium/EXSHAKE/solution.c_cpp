#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)
	{
	    int n;
	    long long m;
	    cin>>n>>m;
	    vector<long long>a(n);
	    for(int i=0;i<n;i++)
	    {
	        cin>>a[i];
	    }
	    sort(a.begin(),a.end());
	    long long people=0;
	    int ans=0;
	    for(int i=0;i<n;i++)
	    {
	        people+=a[i];
	        long long handshakes=people*(people-1)/2;
	        if(handshakes>m)
	        {
	            break;
	        }
	        ans++;
	    }
	    cout<<ans<<endl;
	}
}
