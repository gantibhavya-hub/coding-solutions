#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)
	{
	    int n,s;
	    cin>>n>>s;
	    int ans=-1;
	    for(int c=0;c<=n;c++)
	    {
	        for(int w=0;c+w<=n;w++)
	        {
	            if(4*c-w==s)
	            {
	                if(ans==-1 || c+w<ans)
	                {
	                    ans=c+w;
	                }
	            }
	        }
	    }
	    cout<<ans<<endl;
	}
}
