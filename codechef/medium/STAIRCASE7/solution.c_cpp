#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)
	{
	    int n;
	    cin>>n;
	    int r[n];
	    for(int i=0;i<n;i++)
	    {
	        cin>>r[i];
	    }
	    int count=0;
	    for(int i=1;i<n;i++)
	    {
	        if(r[i]-r[i-1]!=1)
	        {
	            count++;
	        }
	    }
	    cout<<count<<endl;
	}

}
