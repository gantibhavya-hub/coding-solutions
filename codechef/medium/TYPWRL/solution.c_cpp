#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)
	{
	    int n,p;
	    cin>>n>>p;
	    string s;
	    cin>>s;
	    string m="qwertasdfgzxcv";
	    int left=0,right=0;
	    for(char ch=0;ch<n;ch++)
	    {
	        if(m.find(s[ch]))
	        {
	            left++;
	            right=0;
	        }
	        else
	        {
	            right++;
	            left=0;
	        }
	    }
	    cout<<max(left,right)<<endl;
	    
	}
}
