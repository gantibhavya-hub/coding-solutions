#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)
	{
	    int n,m,k;
	    cin>>n>>m>>k;
	    int a[n];
	    for(int i=1;i<=n;i++)
	    {
	        cin>>a[i];
	    }
	    vector<int>v;
	    for(int i=1;i<=n;i++)
	    {
	        if(i!=a[i])
	        {
	            v.push_back(i);
	        }
	    }
	    int i=1;
	    while(i<=k)
	    {
	        cout<<v[i]<<" ";
	        i++;
	    }
	    cout<<endl;
	}
}
