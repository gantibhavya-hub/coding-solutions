#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)
	{
	    long long x,y,d;
	    cin>>x>>y>>d;
	    long long a=x,b=y;
	    while(true)
	    {
	        if(abs(a-b)<=d)
	        {
	            cout<<max(a,b)<<endl;
	            break;
	        }
	        if(a<b)
	        {
	            a+=x;
	        }
	        else
	        {
	            b+=y;
	        }
	    }
	}

}
