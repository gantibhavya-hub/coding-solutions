#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)
	{
	    int n,m,k;
	    cin>>n>>m>>k;
	    int a[m];
	    for(int i=0;i<m;i++)
	    {
	        cin>>a[i];
	    }
	    vector<int>v;
	    for(int i=1;i<=n;i++)
	    {
	        bool occupied=false;
	        for(int j=0;j<m;j++)
	        {
	            if(i==a[j])
	            {
	                occupied=true;
	                break;
	            }
	        }
	        if(!occupied)
	        {
	            v.push_back(i);
	        }
	    }
	    for(int i=0;i<k;i++)
	    {
	        cout<<v[i]<<" ";
	    }
	    cout<<endl;
	}
}
