#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)
	{
	    int n;
	    cin>>n;
	    int a[n];
	    for(int i=0;i<n;i++)
	    {
	        cin>>a[i];
	    }
	    int maxi=INT_MIN;
	    for(int i=0;i<n;i++)
	    {
	        int sum=0;
	        a[i]=2*i;
	        for(int j=i+1;j<n;j++)
	        {
	            sum=sum+a[i]+a[j];
	        }
	        maxi=max(maxi,sum-)
	    }
	}

}
