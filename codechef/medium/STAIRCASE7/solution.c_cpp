#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)
	{
	    int n;
	    cin>>n;
	    int r[n];
	    for(int i=0;i<n;i++)
	    {
	        cin>>r[i];
	    }
	    map<int,int>m;
	    int maxCount=0;
	    for(int i=0;i<n;i++){
	        int x=r[i]-i;
	        m[x]++;
	        if(m[x]>maxCount)
	        {
	            maxCount=m[x];
	        }
	    }
	    int answer=n-maxCount;
	    cout<<answer<<endl;
	}

}
